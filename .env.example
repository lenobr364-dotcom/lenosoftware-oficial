# SQLite (development). Next.js reads `.env` then `.env.local` (local overrides).
# A root `.env` with DATABASE_URL is optional but helps `npx prisma db push` without extra flags.
DATABASE_URL="file:./dev.db"

# CEO dashboard login (required for /dashboard and license status updates)
ADMIN_EMAIL="ceo@example.com"
ADMIN_PASSWORD="change-me-in-production"

# HMAC for CEO session cookie (and legacy vault gate). Use a long random string in production.
CHEMVAULT_SESSION_SECRET="change-me"

# AES-256-GCM for sensitive Formula fields (instrucoes, descricao, ativo_principal) at rest.
# Prefer 64 hex chars (32-byte key) or any string (hashed to 32 bytes). If unset, derives from CHEMVAULT_SESSION_SECRET / AUTH_MASTER_KEY.
# CHEMVAULT_FORMULA_ENCRYPTION_KEY=

# Bearer token for autonomous agents auditing industrial formula licenses (GET /api/agents/formula-licenses/audit).
# CHEMVAULT_FORMULA_AGENT_SECRET=
#
# Bearer token for NEXUS lab intelligence (agents, automation tick, AI invoke). CEO session also accepted on most routes.
# CHEMVAULT_LAB_AGENT_SECRET=
#
# HMAC dedicado para cookie de atestação do QG (Barra do Garças · CEP 78600-412). Default: deriva de CHEMVAULT_SESSION_SECRET.
# CHEMVAULT_HQ_LAB_SECRET=
# Limite de pedidos/min por IP nas APIs /api/nexus/lab/* (default 90).
# CHEMVAULT_LAB_RATE_LIMIT_PER_MIN=90
# HSTS em produção: CHEMVAULT_ENABLE_HSTS=1 ou deploy na Vercel (automático).
# ─── MFA administrador (CEO) — opcional: totp | email | totp|email (ordem = prioridade) ───
# CHEMVAULT_ADMIN_MFA=off
# Secret Base32 para autenticador TOTP (RFC 6238), ex.: saída de openssl rand -base32 20
# CHEMVAULT_ADMIN_TOTP_SECRET=

# ─── E-mail transacional (Resend) — códigos MFA e tickets de suporte ───
# RESEND_API_KEY=
# CHEMVAULT_MAIL_FROM="ChemVault <noreply@seudominio.com>"
# Caixa interna para tickets (default: ADMIN_EMAIL se não definido)
# CHEMVAULT_SUPPORT_INBOX_EMAIL=

# ─── Alertas admin (licença internacional + segurança CRITICAL) ───
# CHEMVAULT_ADMIN_ALERT_EMAIL= (default: ADMIN_EMAIL)
# Twilio WhatsApp (opcional): mensagem curta em paralelo ao e-mail
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO_ADMIN=whatsapp:+5511999999999

# ─── Projeção de faturamento no admin monitor (por moeda, receita anual estimada) ───
# CHEMVAULT_LICENSE_UNIT_USD_ANNUAL=2500
# CHEMVAULT_LICENSE_UNIT_EUR_ANNUAL=2300
# CHEMVAULT_LICENSE_UNIT_BRL_ANNUAL=12000

# URL canónica / Open Graph (sem barra final) — usada em meta-tags por locale
# NEXT_PUBLIC_APP_URL=https://chemvault.example.com

# ─── Backup encriptado para GCS (1×/dia via cron / Task Scheduler) ───
# Modo A — SDK (recomendado): bucket + credenciais da conta de serviço
# CHEMVAULT_GCS_BACKUP_BUCKET=your-bucket
# CHEMVAULT_GCS_BACKUP_OBJECT_PREFIX=backups/
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# ou JSON inline / Base64:
# GCS_CREDENTIALS_JSON={"type":"service_account",...}
# GCS_CREDENTIALS_JSON_B64=eyJ0eXBlIjoi...
#
# Modo B — URL PUT pré-assinada (v4) para um objeto privado
# CHEMVAULT_GCS_BACKUP_SIGNED_PUT_URL=
#
# Chave AES-256 em hex (64 chars) dedicada ao backup (recomendado em produção)
# CHEMVAULT_BACKUP_ENCRYPTION_KEY=

# Segredo para o middleware (Edge) gravar eventos críticos via POST /api/internal/security-event
# CHEMVAULT_INTERNAL_LOG_SECRET=

# Landing ChemVault gate (?chemvault=1) — chave societária 50/50 (MVP default CHEM5050 se vazio)
LANDING_VAULT_MASTER_KEY="CHEM5050"

# Google Cloud — billing project linked (dashboard “Linked” when set)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_REGION=us-central1

# Gemini (Google AI Studio API key — not the same as GCP console alone)
# Create key: https://aistudio.google.com/app/apikey — enable Gemini 1.5 Pro for the key’s project
# GEMINI_API_KEY=
# Alternative env name supported by the app:
# GOOGLE_GENERATIVE_AI_API_KEY=
# Model id (default in code is gemini-1.5-pro if unset)
# GEMINI_MODEL=gemini-1.5-pro

# Vertex (optional, for ADC / Vertex-only flows later)
# GOOGLE_CLOUD_LOCATION=us-central1

# Opcional: chave legada aceita por getVaultAccessKey() se LANDING_VAULT_MASTER_KEY vazio
# AUTH_MASTER_KEY=

# ─── Portal /api/auth — licença selada (AES-256-GCM) + API externa opcional ───
# Segredo dedicado ao seal (recomendado em produção). Se vazio, deriva de CHEMVAULT_SESSION_SECRET.
# CHEMVAULT_LICENSE_SEAL_KEY=
# Base URL do licensing desk (ex.: https://license.partner.tld). Se vazio, só validação local.
# LICENSE_API_BASE_URL=
# Caminho do POST de validação (default /v1/licenses/validate)
# LICENSE_API_VALIDATE_PATH=/v1/licenses/validate
# LICENSE_API_KEY=
# LICENSE_API_TIMEOUT_MS=5000
# LICENSE_API_MAX_RETRIES=3
# Se true, falhas de rede/5xx não bloqueiam quando o token selado já é válido (revogação explícita ainda nega).
# LICENSE_REMOTE_SOFT_FAIL=false

# ─── Indicadores FX (BRL → moeda de exibição) — ajuste sem redeploy de copy ───
# VAULT_FX_BRL_TO_USD=0.182
# VAULT_FX_BRL_TO_EUR=0.168
# VAULT_FX_BRL_TO_INR=15.1

# Respostas JSON de API incluem campo `lab.detail` com mensagens técnicas (não usar em produção pública).
# LAB_VERBOSE_ERRORS=true

# Atraso artificial (ms) para testar skeletons / percepção de latência (ignorado em produção).
# SIMULATE_API_LATENCY_MS=400

# ─── Checkout ChemVault (Stripe / PayPal) ───
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID= (ID do webhook no dashboard PayPal para validação de cabeçalhos em produção)

# ─── Webhooks (opcional) — notificação a URLs externas ou automações ───
# URLs separadas por vírgula ou nova linha. POST JSON: { id, event, occurredAt, data }.
# Eventos: chemvault.license.activated | chemvault.security.intrusion_detected
# CHEMVAULT_WEBHOOK_URLS=https://hooks.example.com/chemvault
# HMAC SHA-256 do corpo (hex) no header X-ChemVault-Signature: sha256=<digest>
# CHEMVAULT_WEBHOOK_SECRET=

# Opcional: prefixo CDN para `/_next/static` em produção (sem barra final). Ver next.config / documentação Next "assetPrefix".
# CHEMVAULT_ASSET_PREFIX=https://cdn.seudominio.com

# Forçar cabeçalho Strict-Transport-Security em todos os caminhos (além de VERCEL=1). Não usar em http://localhost sem TLS.
# CHEMVAULT_ENABLE_HSTS=1

# Apenas laboratório sem TLS atrás de proxy: desativa redirecionamento HTTP→HTTPS no middleware.
# CHEMVAULT_DISABLE_HTTPS_REDIRECT=1

# Motor de análise de fórmulas (LLM): auto | gemini | openai (openai → stub até integração GPT-4)
# FORMULA_INTEL_PROVIDER=auto

# Stress test POST /api/auth — JSON opcional (default: chave inválida)
# CHEMVAULT_STRESS_AUTH_BODY={"key":"..."}
