{
  "name": "chemvault-global",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run lint && npm run i18n:check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:index:formulas": "prisma migrate deploy",
    "db:backfill-formula-encryption": "tsx scripts/backfill-formula-encryption.mts",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-chemvault.ps1",
    "backup:cloud": "tsx scripts/backup-gcs-daily.mts",
    "i18n:check": "tsx scripts/i18n-utils.mts check",
    "i18n:scan": "tsx scripts/i18n-utils.mts scan",
    "stress:license-auth": "tsx scripts/stress-license-auth.mts",
    "stress:public-locale": "tsx scripts/stress-public-locale.mts",
    "assets:optimize-glass": "tsx scripts/optimize-glass-assets.mts",
    "perf:first-load": "tsx scripts/measure-first-load.mts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.0",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.11.0",
    "next": "16.2.2",
    "next-intl": "^4.9.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "stripe": "^17.7.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "^6.19.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
